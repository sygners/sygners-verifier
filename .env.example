# sygners-verifier — configuration. Copy this file to `.env`.
#
# Everything is optional: the verifier runs without a `.env`. There are no
# command-line options; what can be tuned is tuned here.
#
# For sygners production (OP Mainnet) and its test environment (OP Sepolia),
# this is enough:
#
#   RPC_URL_10=https://mainnet.optimism.io
#   RPC_URL_11155420=https://sepolia.optimism.io
#   EAS_SCHEMA_UID=0xcc6fea68545dd0ab10a1cd630ccf0f63cba74c819c3b334a22d2d1e15468dc5f
#   SYGNERS_ATTESTER_10=0x8ad3446c381c3df420Bba1A1329F71484e7a31D8


# ── RPC, per chain ───────────────────────────────────────────────────────────
#
# The chain is decided by the manifest: the verifier picks THAT chain's RPC and
# aborts if the node answers with another one. Unconfigured, it uses public
# nodes: they work, but they are rate limited and you do not control them.
RPC_URL_10=                # OP Mainnet — where production anchors
RPC_URL_11155420=          # OP Sepolia — the test environment
RPC_URL_11155111=          # Ethereum Sepolia
RPC_URL=                   # wildcard, for any chain without its own line


# ── What is required of the attestations ─────────────────────────────────────
#
# Without these, the verifier reports who anchored and passes no judgement:
# anyone can write an attestation with any contents. With them, one anchored by
# another wallet or under another schema is rejected. This is the trust anchor.
#
# Both accept a chain suffix, and the suffix wins: each environment anchors with
# its own relayer, so a bare value would fail the other environment.
#
# ⚠️ Get them from a source that is NOT the package you are verifying: a
# tampered one also carries values that check out against themselves.
EAS_SCHEMA_UID=            # the same on every chain: it derives from the schema definition
SYGNERS_ATTESTER_10=
SYGNERS_ATTESTER_11155420=


# ── Signers' private keys (optional) ─────────────────────────────────────────
#
# If you are handed a signer's key, the verifier derives its address and
# confirms it controls the wallet that signed. The suffix is free.
#
# The key never signs anything —only its address is derived— and never shows up
# in the report or in an error message.
#
# ⚠️ It establishes control of the wallet, not identity. And asking for a private
# key is asking for full control of that wallet, forever: if all you want is to
# confirm someone controls it, ask them to SIGN a text you choose.
PK_SIGNER1=
PK_SIGNER2=
PK_SIGNER3=


# ── Offline mode ─────────────────────────────────────────────────────────────
#
# true → only the checks that do not touch the chain (structure, hash and, from
# format 2 on, the signatures). The verdict stays PARTIAL, never verified.
OFFLINE=false


# ── Chains the verifier does not know ────────────────────────────────────────
#
# It knows Ethereum (1), Sepolia (11155111), OP (10), OP Sepolia (11155420),
# Base (8453), Base Sepolia (84532), Arbitrum One (42161) and Polygon (137),
# with their official EAS contracts. For any other one, the three variables:
# RPC_URL_<chainId>=
# EAS_CONTRACT_ADDRESS_<chainId>=
# SCHEMA_REGISTRY_ADDRESS_<chainId>=
