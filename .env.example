# sygners-verifier — configuración. Copiá este archivo a `.env`.
#
# Todo es opcional: el verificador corre sin `.env`. No hay opciones de línea de
# comandos; lo que se ajusta, se ajusta acá.
#
# Para la sygners de producción (OP Mainnet) y su entorno de prueba (OP Sepolia),
# con esto alcanza:
#
#   RPC_URL_10=https://mainnet.optimism.io
#   RPC_URL_11155420=https://sepolia.optimism.io
#   EAS_SCHEMA_UID=0xcc6fea68545dd0ab10a1cd630ccf0f63cba74c819c3b334a22d2d1e15468dc5f
#   SYGNERS_ATTESTER_10=0x8ad3446c381c3df420Bba1A1329F71484e7a31D8


# ── RPC, por cadena ──────────────────────────────────────────────────────────
#
# La cadena la decide el manifiesto: el verificador elige el RPC de ESA cadena y
# aborta si el nodo contesta otra. Sin configurar, usa nodos públicos: andan,
# pero tienen límite de pedidos y no los controlás vos.
RPC_URL_10=                # OP Mainnet — donde ancla producción
RPC_URL_11155420=          # OP Sepolia — el entorno de prueba
RPC_URL_11155111=          # Ethereum Sepolia
RPC_URL=                   # comodín, para cualquier cadena sin línea propia


# ── Qué se le exige a las atestaciones ───────────────────────────────────────
#
# Sin esto, el verificador informa quién ancló y no opina: cualquiera puede
# escribir una atestación con cualquier contenido. Con esto, una anclada por
# otra wallet o bajo otro schema se rechaza. Es el ancla de confianza.
#
# Las dos aceptan sufijo de cadena, y el sufijo gana: cada entorno ancla con su
# propio relayer, así que un valor suelto haría fallar al otro entorno.
#
# ⚠️ Conseguilas de una fuente que NO sea el paquete que estás verificando: uno
# adulterado también trae valores que se verifican contra sí mismos.
EAS_SCHEMA_UID=            # el mismo en toda cadena: sale de la definición del schema
SYGNERS_ATTESTER_10=
SYGNERS_ATTESTER_11155420=


# ── Claves privadas de firmantes (opcional) ──────────────────────────────────
#
# Si te entregan la clave de un firmante, el verificador deriva su dirección y
# confirma que controla la wallet que firmó. El sufijo es libre.
#
# La clave nunca firma nada —solo se deriva su dirección— y nunca sale en el
# informe ni en un mensaje de error.
#
# ⚠️ Acredita control de la wallet, no identidad. Y pedir una clave privada es
# pedir el control entero de esa wallet, para siempre: si solo querés confirmar
# que alguien la controla, pedile que FIRME un texto que elijas vos.
PK_SIGNER1=
PK_SIGNER2=
PK_SIGNER3=


# ── Modo sin red ─────────────────────────────────────────────────────────────
#
# true → solo los chequeos que no tocan la cadena (estructura, hash y, desde el
# formato 2, las firmas). El veredicto queda PARCIAL, nunca verificado.
SIN_CADENA=false


# ── Cadenas que el verificador no conoce ─────────────────────────────────────
#
# Conoce Ethereum (1), Sepolia (11155111), OP (10), OP Sepolia (11155420),
# Base (8453), Base Sepolia (84532), Arbitrum One (42161) y Polygon (137), con
# sus contratos oficiales de EAS. Para cualquier otra, las tres variables:
# RPC_URL_<chainId>=
# EAS_CONTRACT_ADDRESS_<chainId>=
# SCHEMA_REGISTRY_ADDRESS_<chainId>=
