# ─────────────────────────────────────────────────────────────────────────────
# sygners-verifier — variables de entorno
#
# Copiá este archivo a `.env` y completá lo que necesites. TODO tiene un valor
# por defecto razonable: el verificador corre sin `.env` y sin cuenta en ningún
# lado. Las variables existen para tres cosas: apuntar a tus propios RPC, fijar
# expectativas más estrictas (schema y atestador esperados) y trabajar offline.
# ─────────────────────────────────────────────────────────────────────────────
#
# Para verificar evidencia de la sygners de PRODUCCIÓN, con esto alcanza
# (comprobado on-chain el 22/09/2026):
#
#   RPC_URL_10=https://mainnet.optimism.io
#   EAS_SCHEMA_UID=0xcc6fea68545dd0ab10a1cd630ccf0f63cba74c819c3b334a22d2d1e15468dc5f
#   SYGNERS_ATTESTER=0x8ad3446c381c3df420Bba1A1329F71484e7a31D8
#
# Ninguno de los tres es secreto: la red es pública, el schema está publicado en
# el SchemaRegistry de OP y el atestador figura en cada atestación. Lo que NO va
# acá, y el verificador nunca necesita, es la clave privada del relayer: este
# programa lee la cadena, no escribe en ella.
# ─────────────────────────────────────────────────────────────────────────────


# ── 1. RPC, por cadena ───────────────────────────────────────────────────────
#
# La cadena la decide el manifiesto (`cadena.chainId`), nunca esta configuración:
# el verificador elige el RPC de ESA cadena y aborta si el nodo contesta otra.
#
# Si no ponés nada se usan nodos públicos (ver `src/config.js`). Andan, pero
# tienen límite de pedidos y no los controlás vos: para una verificación que
# tenga que sostenerse frente a un tercero, poné tu propio nodo acá.
#
# RPC_URL_<chainId> — el que manda.
RPC_URL_11155111=          # Ethereum Sepolia  (el default del código de sygners)
RPC_URL_1=                 # Ethereum mainnet
RPC_URL_8453=              # Base
RPC_URL_84532=             # Base Sepolia
RPC_URL_10=                # OP Mainnet  ← donde ancla la sygners de producción
RPC_URL_42161=             # Arbitrum One
RPC_URL_137=               # Polygon

# Comodín: se usa para cualquier cadena que no tenga su RPC_URL_<chainId>.
# Igual se valida que el nodo declare el chainId del manifiesto.
RPC_URL=


# ── 2. Contratos EAS, por cadena ─────────────────────────────────────────────
#
# Solo para cadenas que el verificador no conozca, o para apuntar a un deploy
# propio. Los valores por defecto son los oficiales de EAS (docs.attest.org).
#
# ⚠️ El default de `sygners` (`EAS_CONTRACT_ADDRESS=0x42...21`) es el predeploy
# de las cadenas OP-stack (Base, OP). En Sepolia el contrato es otro. Acá cada
# cadena usa el suyo, así que no hace falta tocar esto.
EAS_CONTRACT_ADDRESS_11155111=
SCHEMA_REGISTRY_ADDRESS_11155111=

# Comodín, para una cadena sin tabla propia.
EAS_CONTRACT_ADDRESS=
SCHEMA_REGISTRY_ADDRESS=


# ── 3. Expectativas (opcionales, y las que más aprietan) ─────────────────────
#
# El zip prueba por sí solo que el documento es el que se ancló. Estas dos
# variables agregan lo que el zip NO puede probar solo: que quien ancló es quien
# vos creés que es.
#
# UID del schema de EAS con el que sygners ancla. Si lo ponés, toda atestación
# hecha bajo otro schema se rechaza. Lo imprime `npm run eas:register-schema`.
EAS_SCHEMA_UID=

# Dirección del relayer que firma las atestaciones (el `attester` on-chain).
# Si la ponés, una atestación anclada por otra wallet se rechaza. Es el ancla de
# confianza más fuerte que podés configurar sin llamar a sygners.
SYGNERS_ATTESTER=

# Definición del schema esperada. Se coteja contra el SchemaRegistry de la
# cadena. Cambiala solo si sygners publica una versión nueva.
SYGNERS_SCHEMA_DEFINICION=bytes32 documentHash,string action,string email,address subject,bytes32 sigHash


# ── 4. Comportamiento ────────────────────────────────────────────────────────

# true → no se toca la red: solo los chequeos offline (estructura + hash).
# El veredicto queda como PARCIAL, nunca como verificado.
SIN_CADENA=false

# true → además de las atestaciones, se pide el recibo de cada transacción
# (existe, status=1, fue al contrato de EAS). Más pedidos al RPC.
VERIFICAR_TX=true

# Tolerancia, en segundos, entre la fecha que declara el manifiesto y la que
# quedó en la cadena. Por arriba es un aviso, no una falla: el anclaje ocurre
# poco después de la firma, pero "poco" depende de la red.
TOLERANCIA_FECHA_SEGUNDOS=3600

# Milisegundos antes de dar por colgado un pedido al RPC.
RPC_TIMEOUT_MS=20000

# true → los avisos también hacen fallar la verificación (exit 1).
ESTRICTO=false
